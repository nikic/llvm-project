; RUN: llc -mtriple=x86_64-linux-gnu < %s | FileCheck %s

; Test zeroext/signext attributes with an explicit extension width of 64 bits
; on return values, and the interaction with tail calls.

define signext(64) i32 @ret_i32_sext64(i32 %x) nounwind {
; CHECK-LABEL: ret_i32_sext64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    incl %edi
; CHECK-NEXT:    movslq %edi, %rax
; CHECK-NEXT:    retq
  %y = add i32 %x, 1
  ret i32 %y
}

define zeroext(64) i8 @ret_i8_zext64(i8 %x) nounwind {
; CHECK-LABEL: ret_i8_zext64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    incb %dil
; CHECK-NEXT:    movzbl %dil, %eax
; CHECK-NEXT:    retq
  %y = add i8 %x, 1
  ret i8 %y
}

declare signext(64) i32 @get_i32_sext64()
declare signext(32) i32 @get_i32_sext32()
declare zeroext(64) i32 @get_i32_zext64()

define i64 @use_i32_sext64() nounwind {
; CHECK-LABEL: use_i32_sext64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    callq get_i32_sext64@PLT
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    retq
  %r = call signext(64) i32 @get_i32_sext64()
  %ext = sext i32 %r to i64
  ret i64 %ext
}

define i64 @use_i32_sext32() nounwind {
; CHECK-LABEL: use_i32_sext32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    callq get_i32_sext32@PLT
; CHECK-NEXT:    cltq
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    retq
  %r = call signext(32) i32 @get_i32_sext32()
  %ext = sext i32 %r to i64
  ret i64 %ext
}

define i64 @use_i32_zext64() nounwind {
; CHECK-LABEL: use_i32_zext64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    callq get_i32_zext64@PLT
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    retq
  %r = call zeroext(64) i32 @get_i32_zext64()
  %ext = zext i32 %r to i64
  ret i64 %ext
}

; A tail call is only possible if the callee extends the return value at least
; as far as the caller.

declare zeroext(8) i1 @get_i1_zext8()
declare zeroext(32) i1 @get_i1_zext32()
declare zeroext i1 @get_i1_zext()

define zeroext(8) i1 @tail_call_same_width() nounwind {
; CHECK-LABEL: tail_call_same_width:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jmp get_i1_zext8@PLT # TAILCALL
  %r = tail call zeroext(8) i1 @get_i1_zext8()
  ret i1 %r
}

define zeroext(8) i1 @tail_call_wider_width() nounwind {
; CHECK-LABEL: tail_call_wider_width:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jmp get_i1_zext32@PLT # TAILCALL
  %r = tail call zeroext(32) i1 @get_i1_zext32()
  ret i1 %r
}

define zeroext(32) i1 @tail_call_narrower_width() nounwind {
; CHECK-LABEL: tail_call_narrower_width:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    callq get_i1_zext8@PLT
; CHECK-NEXT:    movzbl %al, %eax
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    retq
  %r = tail call zeroext(8) i1 @get_i1_zext8()
  ret i1 %r
}

define zeroext(8) i1 @tail_call_default_width() nounwind {
; CHECK-LABEL: tail_call_default_width:

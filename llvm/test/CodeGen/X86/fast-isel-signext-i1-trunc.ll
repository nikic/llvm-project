; passed as zero-extended value.

declare void @f(i1 signext)

define void @g(i32 %x) nounwind {
; CHECK-LABEL: g:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    movb %dil, %al
; CHECK-NEXT:    movzbl %al, %edi
; CHECK-NEXT:    andl $1, %edi
; CHECK-NEXT:    negl %edi
; CHECK-NEXT:    callq f@PLT
; CHECK-NEXT:    popq %rax
; CHECK-NEXT:    retq
  %t = trunc i32 %x to i1
  call void @f(i1 signext %t)
  ret void
}

define void @call_i32_sext64(i32 %x) nounwind {
; CHECK-LABEL: call_i32_sext64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    daddiu $sp, $sp, -16
; CHECK-NEXT:    sd $ra, 8($sp) # 8-byte Folded Spill
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    jal take_i32_sext64
; CHECK-NEXT:    addiu $4, $1, 1
; CHECK-NEXT:    ld $ra, 8($sp) # 8-byte Folded Reload
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    daddiu $sp, $sp, 16
  %y = add i32 %x, 1
  call void @take_i32_sext64(i32 %y)
  ret void
}


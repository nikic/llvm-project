# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -O0 -mtriple=mipsel-linux-gnu -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s -check-prefixes=MIPS32
--- |

  define i32 @indirectbr(ptr %addr) {
  entry:
    indirectswitch ptr %addr, [ ptr edgeaddress(@indirectbr, 0), label %L1 ptr edgeaddress(@indirectbr, 1), label %L2 ]

  L1:
    ret i32 0

  L2:
    ret i32 1
  }

...
---
name:            indirectbr
alignment:       4
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  ; MIPS32-LABEL: name: indirectbr
  ; MIPS32: bb.0.entry:
  ; MIPS32-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; MIPS32-NEXT:   liveins: $r4
  ; MIPS32-NEXT: {{  $}}
  ; MIPS32-NEXT:   [[COPY:%[0-9]+]]:gpr32 = COPY $r4
  ; MIPS32-NEXT:   [[ORi:%[0-9]+]]:gpr32 = ORi $r0, 1
  ; MIPS32-NEXT:   [[ORi1:%[0-9]+]]:gpr32 = ORi $r0, 0
  ; MIPS32-NEXT:   PseudoIndirectBranch [[COPY]]
  ; MIPS32-NEXT: {{  $}}
  ; MIPS32-NEXT: bb.1.L1:
  ; MIPS32-NEXT:   $r2 = COPY [[ORi1]]
  ; MIPS32-NEXT:   RetRA implicit $r2
  ; MIPS32-NEXT: {{  $}}
  ; MIPS32-NEXT: bb.2.L2:
  ; MIPS32-NEXT:   $r2 = COPY [[ORi]]
  ; MIPS32-NEXT:   RetRA implicit $r2
  bb.1.entry:
    successors: %bb.2, %bb.3
    liveins: $r4

    %0:gprb(p0) = COPY $r4
    %1:gprb(s32) = G_CONSTANT i32 1
    %2:gprb(s32) = G_CONSTANT i32 0
    G_BRINDIRECT %0(p0)

  bb.2.L1:
    $r2 = COPY %2(s32)
    RetRA implicit $r2

  bb.3.L2:
    $r2 = COPY %1(s32)
    RetRA implicit $r2

...


; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -verify-machineinstrs | FileCheck %s
; RUN: llc < %s -O0 -verify-machineinstrs | FileCheck %s --check-prefix=O0

; WebAssembly has no indirect branches: indirectswitch is expanded into a
; switch over small integers, which replace the edgeaddress constants.

target triple = "wasm32-unknown-unknown"

; Table defined before the function.
@tbl = constant [4 x ptr] [ptr edgeaddress(@f, 0), ptr edgeaddress(@f, 1), ptr edgeaddress(@f, 2), ptr edgeaddress(@f, 3)]

; An edgeaddress that is not a case of any indirectswitch.
@unused = global ptr edgeaddress(@f, 9)

; Cases 1 and 2 share the destination %b, which has a phi and is also
; reachable directly from %entry (critical edges).
define i32 @f(i32 %i, i32 %x) {
; CHECK-LABEL: f:
; CHECK:         .functype f (i32, i32) -> (i32)
; CHECK-NEXT:  # %bb.0: # %entry
; CHECK-NEXT:    block
; CHECK-NEXT:    block
; CHECK-NEXT:    local.get 1
; CHECK-NEXT:    i32.eqz
; CHECK-NEXT:    br_if 0 # 0: down to label1
; CHECK-NEXT:  # %bb.1: # %dispatch
; CHECK-NEXT:    i32.const 2
; CHECK-NEXT:    local.set 1
; CHECK-NEXT:    block
; CHECK-NEXT:    i32.const tbl
; CHECK-NEXT:    local.get 0
; CHECK-NEXT:    i32.const 2
; CHECK-NEXT:    i32.shl
; CHECK-NEXT:    i32.add
; CHECK-NEXT:    i32.load 0
; CHECK-NEXT:    i32.const -2
; CHECK-NEXT:    i32.add
; CHECK-NEXT:    br_table {1, 1, 2, 0} # 1: down to label1
; CHECK-NEXT:    # 2: down to label0
; CHECK-NEXT:    # 0: down to label2
; CHECK-NEXT:  .LBB0_2: # %a
; CHECK-NEXT:    end_block # label2:
; CHECK-NEXT:    i32.const 1
; CHECK-NEXT:    return
; CHECK-NEXT:  .LBB0_3: # %b
; CHECK-NEXT:    end_block # label1:
; CHECK-NEXT:    local.get 1
; CHECK-NEXT:    return
; CHECK-NEXT:  .LBB0_4: # %c
; CHECK-NEXT:    end_block # label0:
; CHECK-NEXT:    i32.const 3
; CHECK-NEXT:    # fallthrough-return
;
; O0-LABEL: f:
; O0:         .functype f (i32, i32) -> (i32)
; O0-NEXT:    .local i64, i32, i32, i32, i32
; O0-NEXT:  # %bb.0: # %entry
; O0-NEXT:    local.get 0
; O0-NEXT:    i64.extend_i32_u
; O0-NEXT:    local.set 2
; O0-NEXT:    i32.const tbl
; O0-NEXT:    local.get 2
; O0-NEXT:    i32.wrap_i64
; O0-NEXT:    i32.const 2
; O0-NEXT:    i32.shl
; O0-NEXT:    i32.add
; O0-NEXT:    i32.load 0
; O0-NEXT:    local.set 3
; O0-NEXT:    local.get 1
; O0-NEXT:    local.set 4
; O0-NEXT:    block
; O0-NEXT:    block
; O0-NEXT:    local.get 1
; O0-NEXT:    i32.eqz
; O0-NEXT:    br_if 0 # 0: down to label1
; O0-NEXT:  # %bb.1: # %dispatch
; O0-NEXT:    i32.const 2
; O0-NEXT:    local.set 5
; O0-NEXT:    local.get 3
; O0-NEXT:    i32.const -2
; O0-NEXT:    i32.add
; O0-NEXT:    local.set 6
; O0-NEXT:    local.get 6
; O0-NEXT:    local.get 5
; O0-NEXT:    i32.gt_u
; O0-NEXT:    drop
; O0-NEXT:    local.get 5
; O0-NEXT:    local.set 4
; O0-NEXT:    block
; O0-NEXT:    local.get 6
; O0-NEXT:    br_table {1, 1, 2, 0} # 1: down to label1
; O0-NEXT:    # 2: down to label0
; O0-NEXT:    # 0: down to label2
; O0-NEXT:  .LBB0_2: # %a
; O0-NEXT:    end_block # label2:
; O0-NEXT:    i32.const 1
; O0-NEXT:    return
; O0-NEXT:  .LBB0_3: # %b
; O0-NEXT:    end_block # label1:
; O0-NEXT:    local.get 4
; O0-NEXT:    return
; O0-NEXT:  .LBB0_4: # %c
; O0-NEXT:    end_block # label0:
; O0-NEXT:    i32.const 3
; O0-NEXT:    return
entry:
  %idx = zext i32 %i to i64
  %slot = getelementptr [4 x ptr], ptr @tbl, i64 0, i64 %idx
  %t = load ptr, ptr %slot
  %cmp = icmp eq i32 %x, 0
  br i1 %cmp, label %b, label %dispatch

dispatch:
  indirectswitch ptr %t, [ ptr edgeaddress(@f, 0), label %a
                           ptr edgeaddress(@f, 1), label %b
                           ptr edgeaddress(@f, 2), label %b
                           ptr edgeaddress(@f, 3), label %c ]

a:
  ret i32 1

b:
  %p = phi i32 [ 2, %dispatch ], [ 2, %dispatch ], [ %x, %entry ]
  ret i32 %p

c:
  ret i32 3
}

; edgeaddress used in the code of other functions.
define ptr @g() {
; CHECK-LABEL: g:
; CHECK:         .functype g () -> (i32)
; CHECK-NEXT:  # %bb.0:
; CHECK-NEXT:    i32.const 0
; CHECK-NEXT:    i32.load .Lf.edgeaddress.3
; CHECK-NEXT:    # fallthrough-return
;
; O0-LABEL: g:
; O0:         .functype g () -> (i32)
; O0-NEXT:  # %bb.0:
; O0-NEXT:    i32.const 0
; O0-NEXT:    i32.load .Lf.edgeaddress.3
; O0-NEXT:    return
  ret ptr edgeaddress(@f, 3)
}

define ptr @h() {
; CHECK-LABEL: h:
; CHECK:         .functype h () -> (i32)
; CHECK-NEXT:  # %bb.0:
; CHECK-NEXT:    i32.const f
; CHECK-NEXT:    # fallthrough-return
;
; O0-LABEL: h:
; O0:         .functype h () -> (i32)
; O0-NEXT:  # %bb.0:
; O0-NEXT:    i32.const f
; O0-NEXT:    return
  ret ptr edgeaddress(@f, 9)
}

; The address operand is an edgeaddress itself (folded to a branch by
; CodeGenPrepare when optimizing).
define i32 @direct() {
; CHECK-LABEL: direct:
; CHECK:         .functype direct () -> (i32)
; CHECK-NEXT:  # %bb.0: # %entry
; CHECK-NEXT:    i32.const 2
; CHECK-NEXT:    # fallthrough-return
;
; O0-LABEL: direct:
; O0:         .functype direct () -> (i32)
; O0-NEXT:  # %bb.0: # %entry
; O0-NEXT:  # %bb.1: # %b
; O0-NEXT:    i32.const 2
; O0-NEXT:    return
entry:
  indirectswitch ptr edgeaddress(@direct, 1), [ ptr edgeaddress(@direct, 0), label %a
                                                ptr edgeaddress(@direct, 1), label %b ]
a:
  ret i32 1
b:
  ret i32 2
}

; Relative offsets between edge addresses ("&&a - &&b").
@reltbl = constant [2 x i32] [
  i32 sub (i32 ptrtoint (ptr edgeaddress(@rel, 0) to i32), i32 ptrtoint (ptr edgeaddress(@rel, 0) to i32)),
  i32 sub (i32 ptrtoint (ptr edgeaddress(@rel, 1) to i32), i32 ptrtoint (ptr edgeaddress(@rel, 0) to i32))]

define i32 @rel(i32 %i) {
; CHECK-LABEL: rel:
; CHECK:         .functype rel (i32) -> (i32)
; CHECK-NEXT:  # %bb.0: # %entry
; CHECK-NEXT:    block
; CHECK-NEXT:    i32.const reltbl
; CHECK-NEXT:    local.get 0
; CHECK-NEXT:    i32.const 2
; CHECK-NEXT:    i32.shl
; CHECK-NEXT:    i32.add
; CHECK-NEXT:    i32.load 0
; CHECK-NEXT:    i32.const 1
; CHECK-NEXT:    i32.eq
; CHECK-NEXT:    br_if 0 # 0: down to label3
; CHECK-NEXT:  # %bb.1: # %a
; CHECK-NEXT:    i32.const 10
; CHECK-NEXT:    return
; CHECK-NEXT:  .LBB4_2: # %b
; CHECK-NEXT:    end_block # label3:
; CHECK-NEXT:    i32.const 20
; CHECK-NEXT:    # fallthrough-return
;
; O0-LABEL: rel:
; O0:         .functype rel (i32) -> (i32)
; O0-NEXT:  # %bb.0: # %entry
; O0-NEXT:    block
; O0-NEXT:    local.get 0
; O0-NEXT:    i32.const 2
; O0-NEXT:    i32.shl
; O0-NEXT:    i32.const reltbl
; O0-NEXT:    i32.add
; O0-NEXT:    i32.load 0
; O0-NEXT:    i32.const 1
; O0-NEXT:    i32.eq
; O0-NEXT:    br_if 0 # 0: down to label3
; O0-NEXT:  # %bb.1: # %a
; O0-NEXT:    i32.const 10
; O0-NEXT:    return
; O0-NEXT:  .LBB4_2: # %b
; O0-NEXT:    end_block # label3:
; O0-NEXT:    i32.const 20
; O0-NEXT:    return
entry:
  %idx = zext i32 %i to i64
  %slot = getelementptr [2 x i32], ptr @reltbl, i64 0, i64 %idx
  %off = load i32, ptr %slot
  %t = getelementptr i8, ptr edgeaddress(@rel, 0), i32 %off
  indirectswitch ptr %t, [ ptr edgeaddress(@rel, 0), label %a
                           ptr edgeaddress(@rel, 1), label %b ]
a:
  ret i32 10
b:
  ret i32 20
}

; Table defined after the function.
@tbl2 = global [2 x ptr] [ptr edgeaddress(@f, 1), ptr edgeaddress(@f, 2)]

; Test zeroext/signext attributes with an explicit extension width.

; Extension of i32 to 64 bits.

declare void @take_i32_sext64(i32 signext(64))
declare void @take_i32_zext64(i32 zeroext(64))
declare void @take_i8_zext64(i8 zeroext(64))
declare void @take_i32_sext(i32 signext)

define void @call_i32_sext64(i32 %x) nounwind {
; CHECK-LABEL: call_i32_sext64:
; CHECK:       ! %bb.0:
; CHECK-NEXT:    save %sp, -176, %sp
; CHECK-NEXT:    add %i0, 1, %i0
; CHECK-NEXT:    call take_i32_sext64
; CHECK-NEXT:    sra %i0, 0, %o0
; CHECK-NEXT:    ret
; CHECK-NEXT:    restore
  %y = add i32 %x, 1
  call void @take_i32_sext64(i32 %y)
  ret void
}


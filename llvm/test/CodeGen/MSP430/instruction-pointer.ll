; Reading the PC (r0) produces the address of the next instruction, no relocation
; is needed.
; OBJ-LABEL: <ip>:
; OBJ-NEXT:    0: mov r0, r12
; OBJ-NEXT:    2: ret

define ptr @ip() {
; CHECK-LABEL: ip:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    mov r0, r12
; CHECK-NEXT:    ret
;
; O0-LABEL: ip:
; O0:         .cfi_startproc
; O0-NEXT:  ; %bb.0:
; O0-NEXT:    mov r0, r12
; O0-NEXT:    ret
  %ip = call ptr @llvm.instruction.pointer.p0()
  ret ptr %ip
}


; indirectbr was removed. It is upgraded to indirectswitch: every distinct
; destination gets an edge address (in order of first appearance), and
; blockaddresses of destinations become these edge addresses everywhere.
; blockaddresses of other blocks stay blockaddresses.

; Table before the function.
@tbl = constant [3 x ptr] [ptr blockaddress(@single, %a), ptr blockaddress(@single, %b), ptr blockaddress(@single, %c)]
@not_dest = global ptr blockaddress(@single, %d)
@in_expr = global i64 sub (i64 ptrtoint (ptr blockaddress(@single, %b) to i64), i64 ptrtoint (ptr blockaddress(@single, %a) to i64))

; A single indirectbr is upgraded in place. Duplicate destinations become a
; single case (with the sum of the branch weights).
;.
; CHECK: @tbl = constant [3 x ptr] [ptr edgeaddress(@single, 0), ptr edgeaddress(@single, 1), ptr edgeaddress(@single, 2)]
; CHECK: @not_dest = global ptr blockaddress(@single, %d)
; CHECK: @in_expr = global i64 sub (i64 ptrtoint (ptr edgeaddress(@single, 1) to i64), i64 ptrtoint (ptr edgeaddress(@single, 0) to i64))
; CHECK: @tbl_after = constant [2 x ptr] [ptr edgeaddress(@single, 0), ptr edgeaddress(@later, 0)]
;.
define i32 @single(ptr %p) {
; CHECK-LABEL: define i32 @single(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    indirectswitch ptr [[P]], [
; CHECK-NEXT:      ptr edgeaddress(@single, 0), label %[[A:.*]]
; CHECK-NEXT:      ptr edgeaddress(@single, 1), label %[[B:.*]]
; CHECK-NEXT:      ptr edgeaddress(@single, 2), label %[[C:.*]]
; CHECK-NEXT:    ], !prof [[PROF0:![0-9]+]]
; CHECK:       [[A]]:
; CHECK-NEXT:    [[PA:%.*]] = phi i32 [ 1, %[[ENTRY]] ]
; CHECK-NEXT:    ret i32 [[PA]]
; CHECK:       [[B]]:
; CHECK-NEXT:    store ptr edgeaddress(@single, 2), ptr [[P]], align 8
; CHECK-NEXT:    ret i32 2
; CHECK:       [[C]]:
; CHECK-NEXT:    ret i32 3
; CHECK:       [[D:.*:]]
; CHECK-NEXT:    ret i32 4
;
entry:
  indirectbr ptr %p, [label %a, label %b, label %a, label %c], !prof !0

a:
  %pa = phi i32 [ 1, %entry ], [ 1, %entry ]
  ret i32 %pa

b:
  ; Forward reference to a block in the same function.
  store ptr blockaddress(@single, %c), ptr %p
  ret i32 2

c:
  ret i32 3

d:
  ret i32 4
}

; Block addresses in another function, and after the function.
define ptr @user() {
; CHECK-LABEL: define ptr @user() {
; CHECK-NEXT:    ret ptr edgeaddress(@single, 2)
;
  ret ptr blockaddress(@single, %c)
}

define ptr @user_not_dest() {
; CHECK-LABEL: define ptr @user_not_dest() {
; CHECK-NEXT:    ret ptr blockaddress(@single, [[D:%.*]])
;
  ret ptr blockaddress(@single, %d)
}

@tbl_after = constant [2 x ptr] [ptr blockaddress(@single, %a), ptr blockaddress(@later, %x)]

; Several indirectbrs branch to a new dispatch block holding the only
; indirectswitch. PHI nodes in the destinations get their incoming values
; from PHI nodes in the dispatch block (poison from indirectbrs not listing
; the destination).
define i32 @multiple(ptr %p, ptr %q, i1 %c0) {
; CHECK-LABEL: define i32 @multiple(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i1 [[C0:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C0]], label %[[X:.*]], label %[[Y:.*]]
; CHECK:       [[X]]:
; CHECK-NEXT:    br label %[[BB0:.*]]
; CHECK:       [[Y]]:
; CHECK-NEXT:    br label %[[BB0]]
; CHECK:       [[A:.*]]:
; CHECK-NEXT:    [[PA:%.*]] = phi i32 [ [[TMP2:%.*]], %[[BB0]] ]
; CHECK-NEXT:    ret i32 [[PA]]
; CHECK:       [[B:.*]]:
; CHECK-NEXT:    [[PB:%.*]] = phi i32 [ [[TMP3:%.*]], %[[BB0]] ]
; CHECK-NEXT:    [[PB_SAME:%.*]] = phi i32 [ 4, %[[BB0]] ]
; CHECK-NEXT:    ret i32 [[PB]]
; CHECK:       [[C:.*]]:
; CHECK-NEXT:    [[PC:%.*]] = phi i32 [ [[TMP4:%.*]], %[[BB0]] ]
; CHECK-NEXT:    ret i32 [[PC]]
; CHECK:       [[BB0]]:
; CHECK-NEXT:    [[TMP1:%.*]] = phi ptr [ [[P]], %[[X]] ], [ [[Q]], %[[Y]] ]
; CHECK-NEXT:    [[TMP2]] = phi i32 [ 1, %[[X]] ], [ poison, %[[Y]] ]
; CHECK-NEXT:    [[TMP3]] = phi i32 [ 2, %[[X]] ], [ 3, %[[Y]] ]
; CHECK-NEXT:    [[TMP4]] = phi i32 [ poison, %[[X]] ], [ 5, %[[Y]] ]
; CHECK-NEXT:    indirectswitch ptr [[TMP1]], [
; CHECK-NEXT:      ptr edgeaddress(@multiple, 0), label %[[A]]
; CHECK-NEXT:      ptr edgeaddress(@multiple, 1), label %[[B]]
; CHECK-NEXT:      ptr edgeaddress(@multiple, 2), label %[[C]]
; CHECK-NEXT:    ], !prof [[PROF1:![0-9]+]]
;
entry:
  br i1 %c0, label %x, label %y

x:
  indirectbr ptr %p, [label %a, label %b, label %a], !prof !1

y:
  indirectbr ptr %q, [label %b, label %c], !prof !2

a:
  %pa = phi i32 [ 1, %x ], [ 1, %x ]
  ret i32 %pa

b:
  %pb = phi i32 [ 2, %x ], [ 3, %y ]
  %pb.same = phi i32 [ 4, %x ], [ 4, %y ]
  ret i32 %pb

c:
  %pc = phi i32 [ 5, %y ]
  ret i32 %pc
}

; Definitions that no longer dominate their uses (the dispatch block makes %c
; reachable from %x) get PHI nodes with poison on the new paths.
define i32 @multiple_dominance(ptr %p, ptr %q, i1 %c0, i32 %v) {
; CHECK-LABEL: define i32 @multiple_dominance(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i1 [[C0:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C0]], label %[[X:.*]], label %[[Y:.*]]
; CHECK:       [[X]]:
; CHECK-NEXT:    [[VX:%.*]] = add i32 [[V]], 1
; CHECK-NEXT:    br label %[[BB0:.*]]
; CHECK:       [[Y]]:
; CHECK-NEXT:    [[VY:%.*]] = add i32 [[V]], 2
; CHECK-NEXT:    br label %[[BB0]]
; CHECK:       [[A:.*]]:
; CHECK-NEXT:    ret i32 [[VX_DISPATCH:%.*]]
; CHECK:       [[B:.*]]:
; CHECK-NEXT:    ret i32 [[VY_DISPATCH:%.*]]
; CHECK:       [[C:.*]]:
; CHECK-NEXT:    br label %[[D:.*]]
; CHECK:       [[D]]:
; CHECK-NEXT:    ret i32 [[VY_DISPATCH]]
; CHECK:       [[BB0]]:
; CHECK-NEXT:    [[VY_DISPATCH]] = phi i32 [ [[VY]], %[[Y]] ], [ poison, %[[X]] ]
; CHECK-NEXT:    [[VX_DISPATCH]] = phi i32 [ poison, %[[Y]] ], [ [[VX]], %[[X]] ]
; CHECK-NEXT:    [[TMP1:%.*]] = phi ptr [ [[P]], %[[X]] ], [ [[Q]], %[[Y]] ]
; CHECK-NEXT:    indirectswitch ptr [[TMP1]], [
; CHECK-NEXT:      ptr edgeaddress(@multiple_dominance, 0), label %[[A]]
; CHECK-NEXT:      ptr edgeaddress(@multiple_dominance, 1), label %[[B]]
; CHECK-NEXT:      ptr edgeaddress(@multiple_dominance, 2), label %[[C]]
; CHECK-NEXT:    ]
;
entry:
  br i1 %c0, label %x, label %y

x:
  %vx = add i32 %v, 1
  indirectbr ptr %p, [label %a]

y:
  %vy = add i32 %v, 2
  indirectbr ptr %q, [label %b, label %c]

a:
  ret i32 %vx

b:
  ret i32 %vy

c:
  br label %d

d:
  ret i32 %vy
}

; The same address in all indirectbrs does not need a PHI node, and an
; indirectbr without destinations becomes an indirectswitch without cases.

; CHECK-SAME: ptr [[P:%.*]], i1 [[C0:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C0]], label %[[X:.*]], label %[[Y:.*]]
; CHECK:       [[X]]:
; CHECK-NEXT:    br label %[[BB0:.*]]
; CHECK:       [[Y]]:
; CHECK-NEXT:    br label %[[BB0]]
; CHECK:       [[A:.*]]:
; CHECK-NEXT:    ret void
; CHECK:       [[B:.*]]:
; CHECK-NEXT:    indirectswitch ptr null, [
; CHECK-NEXT:    ]
; CHECK:       [[BB0]]:
; CHECK-NEXT:    indirectswitch ptr [[P]], [
; CHECK-NEXT:      ptr edgeaddress(@same_address, 0), label %[[A]]
; CHECK-NEXT:      ptr edgeaddress(@same_address, 1), label %[[B]]
; CHECK-NEXT:    ]
;
entry:
  br i1 %c0, label %x, label %y

x:
  indirectbr ptr %p, [label %a, label %b]

y:
  indirectbr ptr %p, [label %b, label %a]

a:
  ret void

b:
  indirectbr ptr null, []
}


; RUN: opt -passes=gvn-hoist -S < %s | FileCheck %s

; The loads are hoisted out of both successors even though the address of one
; of them is taken (a blockaddress is data-only).

@tbl = global ptr blockaddress(@hoist_address_taken, %if.then)

;.
; CHECK: @tbl = global ptr blockaddress(@hoist_address_taken, %if.then)
;.
define i32 @hoist_address_taken(i1 %c, ptr %p) {
; CHECK-LABEL: define i32 @hoist_address_taken(
; CHECK-SAME: i1 [[C:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    br i1 [[C]], label %[[IF_THEN:.*]], label %[[IF_ELSE:.*]]
; CHECK:       [[IF_THEN]]:
; CHECK-NEXT:    [[X:%.*]] = add i32 [[A]], 1
; CHECK-NEXT:    br label %[[END:.*]]
; CHECK:       [[IF_ELSE]]:
; CHECK-NEXT:    [[Y:%.*]] = add i32 [[A]], 2
; CHECK-NEXT:    br label %[[END]]
; CHECK:       [[END]]:
; CHECK-NEXT:    [[R:%.*]] = phi i32 [ [[X]], %[[IF_THEN]] ], [ [[Y]], %[[IF_ELSE]] ]
; CHECK-NEXT:    ret i32 [[R]]
;
entry:
  br i1 %c, label %if.then, label %if.else

if.then:
  %a = load i32, ptr %p
  %x = add i32 %a, 1
  br label %end

if.else:
  %b = load i32, ptr %p
  %y = add i32 %b, 2
  br label %end

end:
  %r = phi i32 [ %x, %if.then ], [ %y, %if.else ]
  ret i32 %r
}

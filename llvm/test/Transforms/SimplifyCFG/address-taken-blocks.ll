; A blockaddress is data-only, so blocks whose address is taken can be merged
; into their predecessor (the blockaddress then refers to the predecessor) and
; empty address-taken blocks are folded into their successor (the blockaddress
; then refers to the successor). A block whose address is taken is not merged
; into the entry block (whose address can't be taken), so that its
; blockaddress isn't lost.

@tbl = global [5 x ptr] [ptr blockaddress(@merge, %b), ptr blockaddress(@merge_into_entry, %b), ptr blockaddress(@fold_two_entry, %t), ptr blockaddress(@dup_arms, %a1), ptr blockaddress(@dup_arms, %a2)]

declare void @f()
declare void @g()

;.
; CHECK: @tbl = global [5 x ptr] [ptr blockaddress(@merge, %a), ptr blockaddress(@merge_into_entry, %b), ptr blockaddress(@fold_two_entry, %join), ptr blockaddress(@dup_arms, %b), ptr blockaddress(@dup_arms, %b)]
;.
define void @merge(i1 %c) {
; CHECK-LABEL: define void @merge(
; CHECK-SAME: i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[A:.*]], label %[[EXIT:.*]]
; CHECK:       [[A]]:
; CHECK-NEXT:    call void @f()
; CHECK-NEXT:    call void @g()
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c, label %a, label %exit

a:
  call void @f()
  br label %b

b:
  call void @g()
  br label %exit

exit:
  ret void
}

define void @merge_into_entry() {
; CHECK-LABEL: define void @merge_into_entry() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void @f()
; CHECK-NEXT:    br label %[[B:.*]]
; CHECK:       [[B]]:
; CHECK-NEXT:    call void @g()
; CHECK-NEXT:    ret void
;
entry:
  call void @f()
  br label %b

b:
  call void @g()
  ret void
}

define i32 @fold_two_entry(i1 %c, i32 %x) {
; CHECK-LABEL: define i32 @fold_two_entry(
; CHECK-SAME: i1 [[C:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[Y:%.*]] = add i32 [[X]], 1
; CHECK-NEXT:    [[SPEC_SELECT:%.*]] = select i1 [[C]], i32 [[Y]], i32 [[X]]
; CHECK-NEXT:    br label %[[JOIN:.*]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    ret i32 [[SPEC_SELECT]]
;
entry:
  br i1 %c, label %t, label %join

t:
  %y = add i32 %x, 1
  br label %join

join:
  %p = phi i32 [ %y, %t ], [ %x, %entry ]
  ret i32 %p
}

define void @dup_arms(i32 %x) {
; CHECK-LABEL: define void @dup_arms(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    switch i32 [[X]], label %[[EXIT:.*]] [
; CHECK-NEXT:      i32 0, label %[[B:.*]]
; CHECK-NEXT:      i32 1, label %[[B]]
; CHECK-NEXT:      i32 2, label %[[B]]
; CHECK-NEXT:    ]
; CHECK:       [[B]]:
; CHECK-NEXT:    call void @f()
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  switch i32 %x, label %exit [
  i32 0, label %a1
  i32 1, label %a2
  i32 2, label %b
  ]

a1:
  br label %b

a2:
  br label %b

b:
  call void @f()
  br label %exit

exit:

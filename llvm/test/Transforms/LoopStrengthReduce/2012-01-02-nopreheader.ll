; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -loop-reduce -S < %s | FileCheck %s
;
; <rdar://10619599> "SelectionDAGBuilder shouldn't visit PHI nodes!" assert.
; <rdar://10655343> SCEVExpander segfault on simple test case

target datalayout = "e-p:32:32:32-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:32:64-f32:32:32-f64:32:64-v64:64:64-v128:128:128-a0:0:64-f80:128:128-f128:128:128-n8:16:32"
target triple = "i386-apple-darwin"

; LSR should convert the inner loop (bb7.us) IV (j.01.us) into float*.
; This involves a nested AddRec, the outer AddRec's loop invariant components
; cannot find a preheader, so they should be expanded in the loop header
; (bb7.lr.ph.us) below the existing phi i.12.us.
; Currently, LSR won't kick in on such loops.
define void @nopreheader(ptr nocapture %a, i32 %n) nounwind {
; CHECK-LABEL: define void @nopreheader(
; CHECK-SAME: ptr captures(none) [[A:%.*]], i32 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = sdiv i32 [[N]], undef
; CHECK-NEXT:    indirectswitch ptr undef, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 0), label %[[BB10_PREHEADER:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[BB10_PREHEADER]]:
; CHECK-NEXT:    indirectswitch ptr undef, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 1), label %[[BB8_PREHEADER_LR_PH:.*]]
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 2), label %[[RETURN:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[BB8_PREHEADER_LR_PH]]:
; CHECK-NEXT:    indirectswitch ptr null, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 3), label %[[BB7_LR_PH_US_PREHEADER:.*]]
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 4), label %[[BB9_PREHEADER:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[BB9_PREHEADER]]:
; CHECK-NEXT:    br label %[[BB9:.*]]
; CHECK:       [[BB7_LR_PH_US_PREHEADER]]:
; CHECK-NEXT:    [[TMP1:%.*]] = shl i32 [[TMP0]], 2
; CHECK-NEXT:    br label %[[BB7_LR_PH_US:.*]]
; CHECK:       [[BB7_LR_PH_US]]:
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi ptr [ [[A]], %[[BB7_LR_PH_US_PREHEADER]] ], [ [[SCEVGEP:%.*]], %[[BB9_US:.*]] ]
; CHECK-NEXT:    indirectswitch ptr undef, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 5), label %[[BB7_US:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[BB7_US]]:
; CHECK-NEXT:    [[LSR_IV2:%.*]] = phi ptr [ [[SCEVGEP3:%.*]], %[[BB7_US]] ], [ [[LSR_IV]], %[[BB7_LR_PH_US]] ]
; CHECK-NEXT:    store float undef, ptr [[LSR_IV2]], align 1
; CHECK-NEXT:    [[SCEVGEP3]] = getelementptr i8, ptr [[LSR_IV2]], i32 4
; CHECK-NEXT:    indirectswitch ptr undef, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 6), label %[[BB9_US]]
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 7), label %[[BB7_US]]
; CHECK-NEXT:    ]
; CHECK:       [[BB9_US]]:
; CHECK-NEXT:    [[SCEVGEP]] = getelementptr i8, ptr [[LSR_IV]], i32 [[TMP1]]
; CHECK-NEXT:    indirectswitch ptr undef, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 8), label %[[BB7_LR_PH_US]]
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 9), label %[[RETURN_LOOPEXIT:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[BB9]]:
; CHECK-NEXT:    indirectswitch ptr undef, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 10), label %[[BB9]]
; CHECK-NEXT:      ptr edgeaddress(@nopreheader, 11), label %[[RETURN_LOOPEXIT1:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[RETURN_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[RETURN]]
; CHECK:       [[RETURN_LOOPEXIT1]]:
; CHECK-NEXT:    br label %[[RETURN]]
; CHECK:       [[RETURN]]:
; CHECK-NEXT:    ret void
;
entry:
  %0 = sdiv i32 %n, undef
  indirectswitch ptr undef, [ ptr edgeaddress(@nopreheader, 0), label %bb10.preheader ]

bb10.preheader:                                   ; preds = %bb4
  indirectswitch ptr undef, [ ptr edgeaddress(@nopreheader, 1), label %bb8.preheader.lr.ph ptr edgeaddress(@nopreheader, 2), label %return ]

bb8.preheader.lr.ph:                              ; preds = %bb10.preheader
  indirectswitch ptr null, [ ptr edgeaddress(@nopreheader, 3), label %bb7.lr.ph.us ptr edgeaddress(@nopreheader, 4), label %bb9 ]

bb7.lr.ph.us:                                     ; preds = %bb9.us, %bb8.preheader.lr.ph
  %i.12.us = phi i32 [ %2, %bb9.us ], [ 0, %bb8.preheader.lr.ph ]
  %tmp30 = mul i32 %0, %i.12.us
  indirectswitch ptr undef, [ ptr edgeaddress(@nopreheader, 5), label %bb7.us ]

bb7.us:                                           ; preds = %bb7.lr.ph.us, %bb7.us
  %j.01.us = phi i32 [ 0, %bb7.lr.ph.us ], [ %1, %bb7.us ]
  %tmp31 = add i32 %tmp30, %j.01.us
  %scevgep9 = getelementptr float, ptr %a, i32 %tmp31
  store float undef, ptr %scevgep9, align 1
  %1 = add nsw i32 %j.01.us, 1
  indirectswitch ptr undef, [ ptr edgeaddress(@nopreheader, 6), label %bb9.us ptr edgeaddress(@nopreheader, 7), label %bb7.us ]

bb9.us:                                           ; preds = %bb7.us
  %2 = add nsw i32 %i.12.us, 1
  indirectswitch ptr undef, [ ptr edgeaddress(@nopreheader, 8), label %bb7.lr.ph.us ptr edgeaddress(@nopreheader, 9), label %return ]

bb9:                                              ; preds = %bb9, %bb8.preheader.lr.ph
  indirectswitch ptr undef, [ ptr edgeaddress(@nopreheader, 10), label %bb9 ptr edgeaddress(@nopreheader, 11), label %return ]

return:                                           ; preds = %bb9, %bb9.us, %bb10.preheader
  ret void
}

; In this case, SCEVExpander simply cannot materialize the AddRecExpr
; that LSR picks. We must detect that %bb8.preheader does not have a
; preheader and avoid performing LSR on %bb7.
define fastcc void @nopreheader2(ptr nocapture %Array2) nounwind {
; CHECK-LABEL: define fastcc void @nopreheader2(
; CHECK-SAME: ptr captures(none) [[ARRAY2:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    indirectswitch ptr undef, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader2, 0), label %[[BB:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[BB]]:
; CHECK-NEXT:    indirectswitch ptr undef, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader2, 1), label %[[BB3_PREHEADER:.*]]
; CHECK-NEXT:      ptr edgeaddress(@nopreheader2, 2), label %[[BB]]
; CHECK-NEXT:    ]
; CHECK:       [[BB3_PREHEADER]]:
; CHECK-NEXT:    br label %[[BB3:.*]]
; CHECK:       [[BB3]]:
; CHECK-NEXT:    indirectswitch ptr undef, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader2, 3), label %[[BB8_PREHEADER_PREHEADER:.*]]
; CHECK-NEXT:      ptr edgeaddress(@nopreheader2, 4), label %[[BB3]]
; CHECK-NEXT:    ]
; CHECK:       [[BB8_PREHEADER_PREHEADER]]:
; CHECK-NEXT:    [[SCEVGEP1:%.*]] = getelementptr i8, ptr [[ARRAY2]], i32 10400
; CHECK-NEXT:    br label %[[BB8_PREHEADER:.*]]
; CHECK:       [[BB8_PREHEADER]]:
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi ptr [ [[SCEVGEP1]], %[[BB8_PREHEADER_PREHEADER]] ], [ [[SCEVGEP2:%.*]], %[[BB9:.*]] ]
; CHECK-NEXT:    indirectswitch ptr null, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader2, 5), label %[[BB7:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[BB7]]:
; CHECK-NEXT:    [[LSR_IV3:%.*]] = phi ptr [ [[SCEVGEP4:%.*]], %[[BB7]] ], [ [[LSR_IV]], %[[BB8_PREHEADER]] ]
; CHECK-NEXT:    store i32 undef, ptr [[LSR_IV3]], align 4
; CHECK-NEXT:    [[SCEVGEP4]] = getelementptr i8, ptr [[LSR_IV3]], i32 4
; CHECK-NEXT:    indirectswitch ptr undef, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader2, 6), label %[[BB9]]
; CHECK-NEXT:      ptr edgeaddress(@nopreheader2, 7), label %[[BB7]]
; CHECK-NEXT:    ]
; CHECK:       [[BB9]]:
; CHECK-NEXT:    [[SCEVGEP2]] = getelementptr i8, ptr [[LSR_IV]], i32 800
; CHECK-NEXT:    indirectswitch ptr undef, [
; CHECK-NEXT:      ptr edgeaddress(@nopreheader2, 8), label %[[RETURN:.*]]
; CHECK-NEXT:      ptr edgeaddress(@nopreheader2, 9), label %[[BB8_PREHEADER]]
; CHECK-NEXT:    ]
; CHECK:       [[RETURN]]:
; CHECK-NEXT:    ret void
;
entry:
  indirectswitch ptr undef, [ ptr edgeaddress(@nopreheader2, 0), label %bb ]

bb:                                               ; preds = %bb, %entry
  indirectswitch ptr undef, [ ptr edgeaddress(@nopreheader2, 1), label %bb3 ptr edgeaddress(@nopreheader2, 2), label %bb ]

bb3:                                              ; preds = %bb3, %bb
  indirectswitch ptr undef, [ ptr edgeaddress(@nopreheader2, 3), label %bb8.preheader ptr edgeaddress(@nopreheader2, 4), label %bb3 ]

bb8.preheader:                                    ; preds = %bb9, %bb3
  %indvar5 = phi i32 [ %indvar.next6, %bb9 ], [ 0, %bb3 ]
  %tmp26 = add i32 %indvar5, 13
  indirectswitch ptr null, [ ptr edgeaddress(@nopreheader2, 5), label %bb7 ]

bb7:                                              ; preds = %bb8.preheader, %bb7
  %indvar = phi i32 [ 0, %bb8.preheader ], [ %indvar.next, %bb7 ]
  %scevgep = getelementptr [200 x i32], ptr %Array2, i32 %tmp26, i32 %indvar
  store i32 undef, ptr %scevgep, align 4
  %indvar.next = add i32 %indvar, 1
  indirectswitch ptr undef, [ ptr edgeaddress(@nopreheader2, 6), label %bb9 ptr edgeaddress(@nopreheader2, 7), label %bb7 ]

bb9:                                              ; preds = %bb7
  %indvar.next6 = add i32 %indvar5, 1
  indirectswitch ptr undef, [ ptr edgeaddress(@nopreheader2, 8), label %return ptr edgeaddress(@nopreheader2, 9), label %bb8.preheader ]

return:                                           ; preds = %bb9
  ret void
}

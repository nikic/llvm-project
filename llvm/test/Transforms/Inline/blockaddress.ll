; A blockaddress is data-only, so functions using blockaddresses can be
; inlined. A blockaddress used by the inlined code refers to the inlined copy
; of the block; other uses keep referring to the callee's block.

@i = global i32 1, align 4
@ptr1 = common global ptr null, align 8


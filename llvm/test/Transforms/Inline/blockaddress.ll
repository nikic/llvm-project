; A function referenced by a global blockaddress can be inlined, also if it
; contains a callbr. The global keeps referring to the callee, and becomes a
; placeholder once the (internal) callee is deleted.
@ba = internal global ptr blockaddress(@foo, %7), align 8
define internal i32 @foo(i32) {
  %2 = alloca i32, align 4
  %3 = alloca i32, align 4
  store i32 %0, ptr %3, align 4
  %4 = load i32, ptr %3, align 4
  callbr void asm sideeffect "testl $0, $0; jne ${1:l};", "r,!i,!i,~{dirflag},~{fpsr},~{flags}"(i32 %4) #1
  to label %5 [label %7, label %6]

; <label>:5:                                      ; preds = %1
  store i32 0, ptr %2, align 4
  br label %8

; <label>:6:                                      ; preds = %1
  store i32 1, ptr %2, align 4
  br label %8

; <label>:7:                                      ; preds = %1
  store i32 2, ptr %2, align 4
  br label %8

; <label>:8:                                      ; preds = %7, %6, %5
  %9 = load i32, ptr %2, align 4
  ret i32 %9
}

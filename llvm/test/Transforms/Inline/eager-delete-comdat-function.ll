; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=inline -inline-threshold=0 -S < %s | FileCheck %s

; When a discardable callee becomes dead after inlining, the inliner drops its
; body right away, so its own callees may become sole-use and receive the
; last-call-to-static bonus within the same inliner run. This also applies to
; functions in a comdat that has no other members.

$single = comdat any
$multi = comdat any

; @single is in a comdat of its own: its body is dropped immediately after it
; is inlined, so @callee1 has a single use and gets inlined too.
define i32 @caller1(i32 %x) {
; CHECK-LABEL: define i32 @caller1(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:    [[V1_I:%.*]] = mul i32 [[X]], 3
; CHECK-NEXT:    [[V2_I:%.*]] = mul i32 [[V1_I]], 5
; CHECK-NEXT:    [[V3_I:%.*]] = mul i32 [[V2_I]], 7
; CHECK-NEXT:    [[V4_I:%.*]] = mul i32 [[V3_I]], 11
; CHECK-NEXT:    [[V5_I:%.*]] = mul i32 [[V4_I]], 13
; CHECK-NEXT:    [[V6_I:%.*]] = mul i32 [[V5_I]], 17
; CHECK-NEXT:    [[V7_I:%.*]] = mul i32 [[V6_I]], 19
; CHECK-NEXT:    [[V8_I:%.*]] = mul i32 [[V7_I]], 23
; CHECK-NEXT:    ret i32 [[V8_I]]
;
  %r = call i32 @single(i1 true, i32 %x)
  ret i32 %r
}

; @multi shares its comdat with @multi_other, so it is only deleted at the end
; of the inliner run. @callee2 still has three uses while it is considered.
define i32 @caller2(i32 %x) {
; CHECK-LABEL: define i32 @caller2(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:    [[A_I:%.*]] = call i32 @callee2(i32 [[X]])
; CHECK-NEXT:    ret i32 [[A_I]]
;
  %r = call i32 @multi(i1 true, i32 %x)
  ret i32 %r
}

; The constant argument prunes one of the two calls when cloning. Each callee
; has two uses while its caller here is processed, so it is not inlined there.
define linkonce_odr i32 @single(i1 %c, i32 %x) likely_module_local comdat {
  br i1 %c, label %t, label %f
t:
  %a = call i32 @callee1(i32 %x)
  ret i32 %a
f:
  %b = call i32 @callee1(i32 %x)
  ret i32 %b
}

define linkonce_odr i32 @multi(i1 %c, i32 %x) likely_module_local comdat {
; CHECK-LABEL: define linkonce_odr i32 @multi(
; CHECK-SAME: i1 [[C:%.*]], i32 [[X:%.*]]) #[[ATTR0:[0-9]+]] comdat {
; CHECK-NEXT:    br i1 [[C]], label %[[T:.*]], label %[[F:.*]]
; CHECK:       [[T]]:
; CHECK-NEXT:    [[A:%.*]] = call i32 @callee2(i32 [[X]])
; CHECK-NEXT:    ret i32 [[A]]
; CHECK:       [[F]]:
; CHECK-NEXT:    [[B:%.*]] = call i32 @callee2(i32 [[X]])
; CHECK-NEXT:    ret i32 [[B]]
;
  br i1 %c, label %t, label %f
t:
  %a = call i32 @callee2(i32 %x)
  ret i32 %a
f:
  %b = call i32 @callee2(i32 %x)
  ret i32 %b
}

define linkonce_odr void @multi_other() comdat($multi) {
; CHECK-LABEL: define linkonce_odr void @multi_other() comdat($multi) {
; CHECK-NEXT:    ret void
;
  ret void
}


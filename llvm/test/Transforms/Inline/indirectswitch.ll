; Functions containing an indirectswitch must not be inlined: the
; indirectswitch can't be duplicated, as its edge addresses may be used outside
; of the function (here: in @tbl).

; REMARK: 'callee' not inlined into 'caller' because it should never be inlined (cost=never): indirect branch
; REMARK: 'callee_always' not inlined into 'caller_always' because it should never be inlined (cost=never): contains indirect branches
; REMARK: 'callee_dead_switch' not inlined into 'caller_dead_switch' because it should never be inlined (cost=never): contains indirect branches

@tbl = constant [2 x ptr] [ptr edgeaddress(@callee, 0), ptr edgeaddress(@callee, 1)]

define internal i32 @callee(ptr %p) {
; CHECK-LABEL: @callee(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    indirectswitch ptr [[P:%.*]], [
; CHECK-NEXT:      ptr edgeaddress(@callee, 0), label [[A:%.*]]
; CHECK-NEXT:      ptr edgeaddress(@callee, 1), label [[B:%.*]]
; CHECK-NEXT:    ]
; CHECK:       a:
; CHECK-NEXT:    ret i32 1
; CHECK:       b:
; CHECK-NEXT:    ret i32 2
;
entry:
  indirectswitch ptr %p, [ ptr edgeaddress(@callee, 0), label %a
                           ptr edgeaddress(@callee, 1), label %b ]
a:
  ret i32 1
b:
  ret i32 2
}

define i32 @caller(ptr %p) {
; CHECK-LABEL: @caller(
; CHECK-NEXT:    [[R:%.*]] = call i32 @callee(ptr [[P:%.*]])
; CHECK-NEXT:    ret i32 [[R]]
;
  %r = call i32 @callee(ptr %p)
  ret i32 %r
}

define internal i32 @callee_always(ptr %p) alwaysinline {
; CHECK-LABEL: @callee_always(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    indirectswitch ptr [[P:%.*]], [
; CHECK-NEXT:      ptr edgeaddress(@callee_always, 0), label [[A:%.*]]
; CHECK-NEXT:      ptr edgeaddress(@callee_always, 1), label [[B:%.*]]
; CHECK-NEXT:    ]
; CHECK:       a:
; CHECK-NEXT:    ret i32 1
; CHECK:       b:
; CHECK-NEXT:    ret i32 2
;
entry:
  indirectswitch ptr %p, [ ptr edgeaddress(@callee_always, 0), label %a
                           ptr edgeaddress(@callee_always, 1), label %b ]
a:
  ret i32 1
b:
  ret i32 2
}

define i32 @caller_always(ptr %p) {
; CHECK-LABEL: @caller_always(
; CHECK-NEXT:    [[R:%.*]] = call i32 @callee_always(ptr [[P:%.*]])
; CHECK-NEXT:    ret i32 [[R]]
;
  %r = call i32 @callee_always(ptr %p)
  ret i32 %r
}

; The indirectswitch is dead at the call site, but the callee still can't be
; inlined.
define internal i32 @callee_dead_switch(ptr %p, i1 %c) alwaysinline {
; CHECK-LABEL: @callee_dead_switch(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br i1 [[C:%.*]], label [[SW:%.*]], label [[A:%.*]]
; CHECK:       sw:
; CHECK-NEXT:    indirectswitch ptr [[P:%.*]], [
; CHECK-NEXT:      ptr edgeaddress(@callee_dead_switch, 0), label [[A]]
; CHECK-NEXT:    ]
; CHECK:       a:
; CHECK-NEXT:    ret i32 1
;
entry:
  br i1 %c, label %sw, label %a
sw:
  indirectswitch ptr %p, [ ptr edgeaddress(@callee_dead_switch, 0), label %a ]
a:
  ret i32 1
}

define i32 @caller_dead_switch(ptr %p) {
; CHECK-LABEL: @caller_dead_switch(
; CHECK-NEXT:    [[R:%.*]] = call i32 @callee_dead_switch(ptr [[P:%.*]], i1 false)
; CHECK-NEXT:    ret i32 [[R]]
;
  %r = call i32 @callee_dead_switch(ptr %p, i1 false)
  ret i32 %r
}

; An edgeaddress without indirectswitch doesn't prevent inlining.
define internal ptr @callee_no_switch() alwaysinline {
  ret ptr edgeaddress(@callee_no_switch, 0)
}

define ptr @caller_no_switch() {
; CHECK-LABEL: @caller_no_switch(
; CHECK-NEXT:    ret ptr inttoptr (i32 1 to ptr)
;
  %r = call ptr @callee_no_switch()
  ret ptr %r
}

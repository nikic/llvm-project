entry:
  indirectswitch ptr edgeaddress(@outer_ph_indirectbr, 0), [ ptr edgeaddress(@outer_ph_indirectbr, 0), label %outer.header ]

outer.header:
  %i = phi i64 [ 0, %entry ], [ %i.inc, %outer.latch ]

; RUN: opt -passes=loop-rotate -S < %s | FileCheck %s

; The latch is folded into the exiting block even though its address is taken
; (a blockaddress is data-only). The blockaddress then refers to the block the
; latch was merged into.

@tbl = global ptr blockaddress(@latch_address_taken, %latch)

declare void @f()

;.
; CHECK: @tbl = global ptr blockaddress(@latch_address_taken, %loop)
;.
define void @latch_address_taken(i32 %n) {
; CHECK-LABEL: define void @latch_address_taken(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[INC:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    call void @f()
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[I]], [[N]]
; CHECK-NEXT:    [[INC]] = add i32 [[I]], 1
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %inc, %latch ]
  call void @f()
  %c = icmp slt i32 %i, %n
  br i1 %c, label %latch, label %exit

latch:
  %inc = add i32 %i, 1
  br label %loop

exit:
  ret void
}

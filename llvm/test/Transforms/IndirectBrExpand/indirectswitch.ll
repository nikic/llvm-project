define i32 @f(ptr %p, i32 %x) #0 {
; CHECK-LABEL: define i32 @f(
; CHECK-SAME: ptr [[P:%.*]], i32 [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[X]], 0
; CHECK-NEXT:    br i1 [[CMP]], label %[[B:.*]], label %[[DISPATCH:.*]]
; CHECK:       [[DISPATCH]]:
; CHECK-NEXT:    [[P_SWITCH_CAST:%.*]] = ptrtoint ptr [[P]] to i64
; CHECK-NEXT:    switch i64 [[P_SWITCH_CAST]], label %[[A:.*]] [
; CHECK-NEXT:      i64 2, label %[[B]]
; CHECK-NEXT:      i64 3, label %[[B]]
; CHECK-NEXT:      i64 4, label %[[C:.*]]
; CHECK-NEXT:    ], !prof [[PROF0:![0-9]+]]
; CHECK:       [[A]]:
; CHECK-NEXT:    ret i32 1
; CHECK:       [[B]]:
; CHECK-NEXT:    [[PHI:%.*]] = phi i32 [ 2, %[[DISPATCH]] ], [ 2, %[[DISPATCH]] ], [ [[X]], %[[ENTRY]] ]
; CHECK-NEXT:    ret i32 [[PHI]]
; CHECK:       [[C]]:
; CHECK-NEXT:    [[PHI_C:%.*]] = phi i32 [ 3, %[[DISPATCH]] ]
; CHECK-NEXT:    ret i32 [[PHI_C]]
;
entry:
  %cmp = icmp eq i32 %x, 0
  br i1 %cmp, label %b, label %dispatch

dispatch:
  indirectswitch ptr %p, [ ptr edgeaddress(@f, 0), label %a
  ptr edgeaddress(@f, 1), label %b
  ptr edgeaddress(@f, 2), label %b
  ptr edgeaddress(@f, 3), label %c
  ptr edgeaddress(@f, 4), label %c ], !prof !0

a:
  ret i32 1

b:
  %phi = phi i32 [ 2, %dispatch ], [ 2, %dispatch ], [ %x, %entry ]
  ret i32 %phi

c:
  %phi.c = phi i32 [ 3, %dispatch ], [ 3, %dispatch ]
  ret i32 %phi.c
}

; No case can be taken.
define void @dead(ptr %p) #0 {
; CHECK-LABEL: define void @dead(

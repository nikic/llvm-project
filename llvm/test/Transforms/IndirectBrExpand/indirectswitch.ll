target triple = "x86_64-unknown-linux-gnu"

; Table defined before the function. Case 4's edgeaddress is only used as a
; case value, so the case is dropped; edgeaddress(@f, 9) is not a case of any
; indirectswitch and is left alone.
@tbl = constant [3 x ptr] [ptr edgeaddress(@f, 0), ptr edgeaddress(@f, 1), ptr edgeaddress(@f, 2)]
@unused = global ptr edgeaddress(@f, 9)

;.

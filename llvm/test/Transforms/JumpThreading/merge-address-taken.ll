; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals all --version 6
; RUN: opt -passes=jump-threading -S < %s | FileCheck %s

; A blockaddress is data-only, so a block whose address is taken can be merged
; with its single predecessor. The blockaddress keeps referring to the merged
; block. It isn't merged with the entry block though, because the merged block
; would become the entry block, whose address can't be taken.

@tbl = global [2 x ptr] [ptr blockaddress(@merge, %bb), ptr blockaddress(@merge_entry, %bb)]

declare void @a()
declare void @b()

;.
; CHECK: @tbl = global [2 x ptr] [ptr blockaddress(@merge, %bb), ptr blockaddress(@merge_entry, %bb)]
;.
define void @merge(i1 %c) {
; CHECK-LABEL: define void @merge(
; CHECK-SAME: i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[BB:.*]], label %[[EXIT:.*]]
; CHECK:       [[BB]]:
; CHECK-NEXT:    call void @a()
; CHECK-NEXT:    call void @b()
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c, label %pred, label %exit

pred:
  call void @a()
  br label %bb

bb:
  call void @b()
  br label %exit

exit:
  ret void
}

define void @merge_entry() {
; CHECK-LABEL: define void @merge_entry() {
; CHECK-NEXT:  [[BB:.*:]]
; CHECK-NEXT:    call void @a()
; CHECK-NEXT:    br label %[[BB1:.*]]
; CHECK:       [[BB1]]:
; CHECK-NEXT:    call void @b()
; CHECK-NEXT:    ret void
;
entry:
  call void @a()
  br label %bb

bb:
  call void @b()
  ret void
}

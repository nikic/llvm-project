; RUN: opt -passes=jump-threading -S < %s | FileCheck %s

; Thread the edges with known edge addresses to the case destinations.

declare void @use(i32)
define void @thread(i1 %c, i32 %x) {
; CHECK-LABEL: define void @thread(
; CHECK-SAME: i1 [[C:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[A:.*]], label %[[B:.*]]
; CHECK:       [[A]]:
; CHECK-NEXT:    call void @use(i32 0)
; CHECK-NEXT:    call void @use(i32 [[X]])
; CHECK-NEXT:    call void @use(i32 10)
; CHECK-NEXT:    ret void
; CHECK:       [[B]]:
; CHECK-NEXT:    call void @use(i32 1)
; CHECK-NEXT:    call void @use(i32 [[X]])
; CHECK-NEXT:    call void @use(i32 20)
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c, label %l, label %r
l:
  call void @use(i32 0)
  br label %m
r:
  call void @use(i32 1)
  br label %m
m:
  %p = phi ptr [ edgeaddress(@thread, 0), %l ], [ edgeaddress(@thread, 1), %r ]
  call void @use(i32 %x)
  indirectswitch ptr %p, [ ptr edgeaddress(@thread, 0), label %a
  ptr edgeaddress(@thread, 1), label %b ]
a:
  call void @use(i32 10)
  ret void
b:
  call void @use(i32 20)
  ret void
}

; An address which is not a case is UB.
define void @not_a_case(i1 %c, ptr %q) {
; CHECK-LABEL: define void @not_a_case(
; CHECK-SAME: i1 [[C:%.*]], ptr [[Q:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C]], label %[[M_THREAD:.*]], label %[[M:.*]]
; CHECK:       [[M_THREAD]]:
; CHECK-NEXT:    call void @use(i32 0)
; CHECK-NEXT:    call void @use(i32 1)
; CHECK-NEXT:    br label %[[A:.*]]
; CHECK:       [[M]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[Q]], %[[ENTRY]] ]
; CHECK-NEXT:    call void @use(i32 1)
; CHECK-NEXT:    indirectswitch ptr [[P]], [
; CHECK-NEXT:      ptr edgeaddress(@not_a_case, 0), label %[[A]]
; CHECK-NEXT:      ptr edgeaddress(@not_a_case, 1), label %[[B:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[A]]:
; CHECK-NEXT:    call void @use(i32 10)
; CHECK-NEXT:    ret void
; CHECK:       [[B]]:
; CHECK-NEXT:    call void @use(i32 20)
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c, label %l, label %m
l:
  call void @use(i32 0)
  br label %m
m:
  %p = phi ptr [ edgeaddress(@not_a_case, 5), %l ], [ %q, %entry ]
  call void @use(i32 1)
  indirectswitch ptr %p, [ ptr edgeaddress(@not_a_case, 0), label %a
  ptr edgeaddress(@not_a_case, 1), label %b ]
a:
  call void @use(i32 10)
  ret void
b:
  call void @use(i32 20)
  ret void
}

; A blockaddress is never equal to an edgeaddress case (UB). Don't loop
; trying to fold the terminator.
define void @blockaddress_address() {
; CHECK-LABEL: define void @blockaddress_address() {
; CHECK-NEXT:  [[A:.*:]]
; CHECK-NEXT:    ret void
; CHECK:       [[BB:.*:]]
; CHECK-NEXT:    call void @use(i32 0)
; CHECK-NEXT:    ret void
;
entry:
  indirectswitch ptr blockaddress(@blockaddress_address, %bb), [ ptr edgeaddress(@blockaddress_address, 0), label %a ]
a:
  ret void
bb:
  call void @use(i32 0)
  ret void
}

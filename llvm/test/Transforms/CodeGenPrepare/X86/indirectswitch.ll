; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='require<profile-summary>,function(codegenprepare)' -S -mtriple=x86_64 < %s | FileCheck %s

; CodeGenPrepare treats indirectswitch like indirectbr: critical edges into
; blocks with phis are split by duplicating the phis for the direct
; predecessors, so the destination of the indirect edge stays the original
; block, and geps are unmerged across the indirect branch.

declare void @use(i32)

@simple.targets = constant [2 x ptr] [ptr edgeaddress(@simple, 0), ptr edgeaddress(@simple, 1)]

define void @simple(ptr nocapture readonly %p) {
; CHECK-LABEL: define void @simple(
; CHECK-SAME: ptr readonly captures(none) [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[INCDEC_PTR:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 1
; CHECK-NEXT:    [[INITVAL:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[INITOP:%.*]] = load i32, ptr [[INCDEC_PTR]], align 4
; CHECK-NEXT:    switch i32 [[INITOP]], label %[[EXIT:.*]] [
; CHECK-NEXT:      i32 0, label %[[OP0_CLONE:.*]]
; CHECK-NEXT:      i32 1, label %[[OP1S_CLONE:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[OP0_CLONE]]:
; CHECK-NEXT:    [[P_ADDR_0:%.*]] = phi ptr [ [[INCDEC_PTR]], %[[ENTRY]] ], [ [[PTR:%.*]], %[[OP0:.*]] ]
; CHECK-NEXT:    [[MERGE2:%.*]] = phi i32 [ [[INITVAL]], %[[ENTRY]] ], [ 0, %[[OP0]] ]
; CHECK-NEXT:    tail call void @use(i32 [[MERGE2]])
; CHECK-NEXT:    br label %[[DOTSPLIT3:.*]]
; CHECK:       [[OP1S_CLONE]]:
; CHECK-NEXT:    [[P_ADDR_1:%.*]] = phi ptr [ [[INCDEC_PTR]], %[[ENTRY]] ], [ [[PTR]], %[[OP1S:.*]] ]
; CHECK-NEXT:    [[MERGE7:%.*]] = phi i32 [ [[INITVAL]], %[[ENTRY]] ], [ 1, %[[OP1S]] ]
; CHECK-NEXT:    tail call void @use(i32 [[MERGE7]])
; CHECK-NEXT:    br label %[[DOTSPLIT3]]
; CHECK:       [[DOTSPLIT3]]:
; CHECK-NEXT:    [[P_ADDR_SINK:%.*]] = phi ptr [ [[P_ADDR_1]], %[[OP1S_CLONE]] ], [ [[P_ADDR_0]], %[[OP0_CLONE]] ]
; CHECK-NEXT:    [[PTR]] = getelementptr inbounds i32, ptr [[P_ADDR_SINK]], i64 1
; CHECK-NEXT:    [[NEWP:%.*]] = load i32, ptr [[P_ADDR_SINK]], align 4
; CHECK-NEXT:    [[IDX:%.*]] = sext i32 [[NEWP]] to i64
; CHECK-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds [2 x ptr], ptr @simple.targets, i64 0, i64 [[IDX]]
; CHECK-NEXT:    [[NEWOP:%.*]] = load ptr, ptr [[ARRAYIDX]], align 8
; CHECK-NEXT:    indirectswitch ptr [[NEWOP]], [
; CHECK-NEXT:      ptr edgeaddress(@simple, 0), label %[[OP0]]
; CHECK-NEXT:      ptr edgeaddress(@simple, 1), label %[[OP1S]]
; CHECK-NEXT:    ]
; CHECK:       [[OP1S]]:
; CHECK-NEXT:    br label %[[OP1S_CLONE]]
; CHECK:       [[OP0]]:
; CHECK-NEXT:    br label %[[OP0_CLONE]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %incdec.ptr = getelementptr inbounds i32, ptr %p, i64 1
  %initval = load i32, ptr %p, align 4
  %initop = load i32, ptr %incdec.ptr, align 4
  switch i32 %initop, label %exit [
  i32 0, label %op0
  i32 1, label %op1s
  ]

op0:
  %p.addr.0 = phi ptr [ %incdec.ptr, %entry ], [ %ptr, %indirectgoto ]
  %opcode.0 = phi i32 [ %initval, %entry ], [ 0, %indirectgoto ]
  tail call void @use(i32 %opcode.0)
  br label %indirectgoto

op1s:
  %p.addr.1 = phi ptr [ %incdec.ptr, %entry ], [ %ptr, %indirectgoto ]
  %opcode.1 = phi i32 [ %initval, %entry ], [ 1, %indirectgoto ]
  tail call void @use(i32 %opcode.1)
  br label %indirectgoto

indirectgoto:
  %p.addr.sink = phi ptr [ %p.addr.1, %op1s ], [ %p.addr.0, %op0 ]
  %ptr = getelementptr inbounds i32, ptr %p.addr.sink, i64 1
  %newp = load i32, ptr %p.addr.sink, align 4
  %idx = sext i32 %newp to i64
  %arrayidx = getelementptr inbounds [2 x ptr], ptr @simple.targets, i64 0, i64 %idx
  %newop = load ptr, ptr %arrayidx, align 8
  indirectswitch ptr %newop, [ ptr edgeaddress(@simple, 0), label %op0
  ptr edgeaddress(@simple, 1), label %op1s ]

exit:
  ret void
}

@table = constant [3 x ptr] [ptr edgeaddress(@gep_unmerging, 0), ptr edgeaddress(@gep_unmerging, 1), ptr edgeaddress(@gep_unmerging, 2)]
@dummy = global i8 0

define void @gep_unmerging(i1 %pred, ptr %p0) {
; CHECK-LABEL: define void @gep_unmerging(
; CHECK-SAME: i1 [[PRED:%.*]], ptr [[P0:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[DISPATCH:.*]]
; CHECK:       [[OP1:.*]]:
; CHECK-NEXT:    [[P1_INC2:%.*]] = getelementptr i8, ptr [[P_PREINC:%.*]], i64 3
; CHECK-NEXT:    [[P1_INC1:%.*]] = getelementptr i8, ptr [[P_PREINC]], i64 2
; CHECK-NEXT:    [[SUNKADDR:%.*]] = getelementptr i8, ptr [[P_PREINC]], i64 1
; CHECK-NEXT:    [[A10:%.*]] = load i8, ptr [[SUNKADDR]], align 1
; CHECK-NEXT:    [[A11:%.*]] = load i8, ptr [[P1_INC1]], align 1
; CHECK-NEXT:    [[A12:%.*]] = add i8 [[A10]], [[A11]]
; CHECK-NEXT:    store i8 [[A12]], ptr @dummy, align 1
; CHECK-NEXT:    br i1 [[PRED]], label %[[DISPATCH]], label %[[EXIT:.*]]
; CHECK:       [[OP2:.*]]:
; CHECK-NEXT:    [[P2_INC:%.*]] = getelementptr i8, ptr [[P_PREINC]], i64 2
; CHECK-NEXT:    [[SUNKADDR1:%.*]] = getelementptr i8, ptr [[P_PREINC]], i64 1
; CHECK-NEXT:    [[A2:%.*]] = load i8, ptr [[SUNKADDR1]], align 1
; CHECK-NEXT:    store i8 [[A2]], ptr @dummy, align 1
; CHECK-NEXT:    br i1 [[PRED]], label %[[DISPATCH]], label %[[EXIT]]
; CHECK:       [[DISPATCH]]:
; CHECK-NEXT:    [[P_PREINC]] = phi ptr [ [[P0]], %[[ENTRY]] ], [ [[P1_INC2]], %[[OP1]] ], [ [[P2_INC]], %[[OP2]] ]
; CHECK-NEXT:    [[NEXT_OP:%.*]] = load i8, ptr [[P_PREINC]], align 1
; CHECK-NEXT:    [[P_ZEXT:%.*]] = zext i8 [[NEXT_OP]] to i64
; CHECK-NEXT:    [[SLOT:%.*]] = getelementptr [3 x ptr], ptr @table, i64 0, i64 [[P_ZEXT]]
; CHECK-NEXT:    [[TARGET:%.*]] = load ptr, ptr [[SLOT]], align 8
; CHECK-NEXT:    indirectswitch ptr [[TARGET]], [
; CHECK-NEXT:      ptr edgeaddress(@gep_unmerging, 0), label %[[EXIT]]
; CHECK-NEXT:      ptr edgeaddress(@gep_unmerging, 1), label %[[OP1]]
; CHECK-NEXT:      ptr edgeaddress(@gep_unmerging, 2), label %[[OP2]]
; CHECK-NEXT:    ]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %dispatch

op1:
  %p1_inc2 = getelementptr i8, ptr %p_preinc, i64 3
  %p1_inc1 = getelementptr i8, ptr %p_preinc, i64 2
  %a10 = load i8, ptr %p_postinc
  %a11 = load i8, ptr %p1_inc1
  %a12 = add i8 %a10, %a11
  store i8 %a12, ptr @dummy
  br i1 %pred, label %dispatch, label %exit

op2:
  %p2_inc = getelementptr i8, ptr %p_preinc, i64 2
  %a2 = load i8, ptr %p_postinc
  store i8 %a2, ptr @dummy
  br i1 %pred, label %dispatch, label %exit

dispatch:
  %p_preinc = phi ptr [%p0, %entry], [%p1_inc2, %op1], [%p2_inc, %op2]
  %p_postinc = getelementptr i8, ptr %p_preinc, i64 1
  %next_op = load i8, ptr %p_preinc
  %p_zext = zext i8 %next_op to i64
  %slot = getelementptr [3 x ptr], ptr @table, i64 0, i64 %p_zext
  %target = load ptr, ptr %slot
  indirectswitch ptr %target, [ ptr edgeaddress(@gep_unmerging, 0), label %exit
  ptr edgeaddress(@gep_unmerging, 1), label %op1
  ptr edgeaddress(@gep_unmerging, 2), label %op2 ]

exit:
  ret void
}

; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=ipsccp -S < %s | FileCheck %s

; IPSCCP keeps the dead address-taken block %dead (as unreachable): deleting it
; would destroy blockaddress(@f, %dead), which is still referenced by the
; lattice value of the argument of @g, which is processed after @f.

define void @f(i1 %c) {
; CHECK-LABEL: define void @f(
; CHECK-SAME: i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void @g(ptr blockaddress(@f, %[[DEAD:.*]]))
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[DEAD]]:
; CHECK-NEXT:    unreachable
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  call void @g(ptr blockaddress(@f, %dead))
  br i1 false, label %dead, label %exit
dead:
  call void @g(ptr blockaddress(@f, %dead))
  br label %exit
exit:
  ret void
}

define internal void @g(ptr %p) noinline {
; CHECK-LABEL: define internal void @g(
; CHECK-SAME: ptr [[P:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    store volatile ptr blockaddress(@f, [[DEAD:%.*]]), ptr null, align 8
; CHECK-NEXT:    ret void
;
  store volatile ptr %p, ptr null
  ret void
}
